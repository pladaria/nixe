#version 450
layout(local_size_x = 64) in;
layout(set = 0, binding = 0, std430) buffer Words { uint words[]; } data;
layout(push_constant) uniform Args { uint first; uint count; } args;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= args.count) return;
    uint v = data.words[args.first + i];
    data.words[args.first + i] = (v & 0xff00ff00u) | ((v & 0xffu) << 16) | ((v >> 16) & 0xffu);
}
