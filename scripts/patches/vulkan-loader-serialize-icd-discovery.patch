diff --git a/loader/loader.c b/loader/loader.c
--- a/loader/loader.c
+++ b/loader/loader.c
@@ -7558,6 +7558,11 @@
 
 VKAPI_ATTR VkResult VKAPI_CALL terminator_EnumerateInstanceExtensionProperties(const char *pLayerName, uint32_t *pPropertyCount,
                                                                                VkExtensionProperties *pProperties) {
+    // Match vkCreateInstance's lock order: loader_lock, then loader_preload_icd_lock.
+    // NVIDIA 595.58.03 can publish its initialization flag before its negotiation
+    // dispatch pointer is ready. Concurrent ICD discovery must not enter that window.
+    loader_platform_thread_lock_mutex(&loader_lock);
+
     struct loader_extension_list *global_ext_list = NULL;
     struct loader_layer_list instance_layers;
     struct loader_extension_list local_ext_list;
@@ -7648,6 +7653,7 @@
     loader_destroy_generic_list(NULL, (struct loader_generic_list *)&icd_tramp_list);
     loader_destroy_generic_list(NULL, (struct loader_generic_list *)&local_ext_list);
     loader_delete_layer_list_and_properties(NULL, &instance_layers);
+    loader_platform_thread_unlock_mutex(&loader_lock);
     return res;
 }
 
